---
import InnerPage from "../../layouts/InnerPage.astro";
import { Image } from "astro:assets";
import { photosList } from "../../data/photos";

const fil = [{ label: "Accueil", href: "/" }, { label: "Crédits photos" }];
const description =
  "Crédits et licences des photographies du site de Sainte-Marie-aux-Mines : sources Wikimedia Commons, auteurs et licences Creative Commons.";
---
<InnerPage
  title="Crédits photos"
  description={description}
  eyebrow="Mentions"
  breadcrumb={fil}
  lede="Origine, auteurs et licences des photographies du site."
>
  <div class="credits">
    <div class="prose">
      <p class="lead">
        Les photographies du site illustrant le patrimoine de Sainte-Marie-aux-Mines
        proviennent de <strong>Wikimedia Commons</strong> et sont diffusées sous
        licence <strong>Creative Commons</strong> ou dans le domaine public.
        L’auteur et la licence sont rappelés sur chaque cliché et dans la liste
        ci-dessous.
      </p>
      <p>
        À terme, ces images pourront être remplacées par des
        <strong>photographies originales</strong> du patrimoine (façades, mines,
        minéraux, vallée), réalisées pour la commune.
      </p>
    </div>

    <h2 class="credits__heading">Photographies utilisées</h2>
    <ul class="credits__gallery" role="list">
      {photosList.map((p) => (
        <li class="credits__item">
          <Image class="credits__thumb" src={p.img} alt={p.alt} width={480} densities={[1, 1.5]} loading="lazy" decoding="async" />
          <div class="credits__meta">
            <span class="credits__title">
              {p.source
                ? <a class="credits__link" href={p.source} target="_blank" rel="noopener noreferrer">{p.titre}<span class="visually-hidden"> — fichier sur Wikimedia Commons (nouvel onglet)</span></a>
                : p.titre}
            </span>
            <span class="credits__by">© {p.auteur}</span>
            <span class="credits__licence">{p.licence}</span>
          </div>
        </li>
      ))}
      <li class="credits__item">
        <span class="credits__thumb credits__thumb--blason">
          <img src="/blason.svg" alt="Blason de Sainte-Marie-aux-Mines" width="60" height="69" />
        </span>
        <div class="credits__meta">
          <span class="credits__title">Blason de la commune</span>
          <span class="credits__by">Wikimedia Commons</span>
          <span class="credits__licence">Voir la page du fichier</span>
        </div>
      </li>
    </ul>

    <div class="note-card credits__note">
      <h3>Vous êtes l’auteur d’une image&nbsp;?</h3>
      <p>
        Pour toute question relative aux droits d’usage ou à l’attribution d’un
        visuel, écrivez à la mairie via la <a href="/contact/">page contact</a>.
      </p>
    </div>
  </div>

  <style>
    .credits { max-width: 980px; }
    .credits__heading {
      font-family: var(--serif);
      font-weight: 500;
      font-size: clamp(1.375rem, 3.4vw, 1.75rem);
      line-height: 1.1;
      color: var(--encre);
      margin: 40px 0 20px;
    }
    .credits__gallery {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
    .credits__item {
      background: var(--parchemin-2);
      border: 1px solid var(--bord-clair);
      border-radius: var(--rayon);
      overflow: hidden;
    }
    .credits__thumb {
      width: 100%;
      height: 160px;
      object-fit: cover;
      display: block;
      background: var(--parchemin);
    }
    .credits__thumb--blason {
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--sable);
    }
    .credits__thumb--blason img { width: auto; height: 96px; }
    .credits__meta { padding: 14px 16px; display: flex; flex-direction: column; gap: 4px; }
    .credits__title { font: 600 0.9375rem/1.3 var(--sans); color: var(--encre-2); }
    .credits__link { color: var(--gueules); text-decoration: none; }
    .credits__link:hover { text-decoration: underline; text-underline-offset: 2px; }
    .credits__by { font: 400 0.84375rem/1.3 var(--sans); color: var(--texte-muet); }
    .credits__licence {
      align-self: flex-start;
      margin-top: 4px;
      font: 600 0.71875rem/1 var(--sans);
      color: var(--texte);
      background: var(--parchemin);
      border: 1px solid var(--bord-clair);
      border-radius: 3px;
      padding: 5px 8px;
    }
    .credits__note { margin-top: 40px; max-width: 820px; }
    .credits__note p { margin: 0; font: 400 0.9375rem/1.6 var(--sans); color: var(--texte-2); }
    .credits__note a { color: var(--gueules); font-weight: 600; }

    @media (max-width: 760px) { .credits__gallery { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 480px) { .credits__gallery { grid-template-columns: 1fr; } }
  </style>
</InnerPage>
