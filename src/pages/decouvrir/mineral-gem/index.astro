---
// Page vitrine « Mineral & Gem » — présentation immersive (aucune billetterie,
// aucun tarif). SEULE page full-dark immersive du site (le grand moment galerie).
// Données : src/data/mineral-gem.ts. Lisible et navigable sans JS ni animation.
import Base from "../../../layouts/Base.astro";
import MinerTools from "../../../components/MinerTools.astro";
import { mineralGem as mg } from "../../../data/mineral-gem";
import { photos } from "../../../data/photos";

const description = `Mineral & Gem à Sainte-Marie-aux-Mines (${mg.dates}) : ${mg.rang}. ${mg.edition}, thème « ${mg.theme} ». ${mg.exposants}, ${mg.surface}. Présentation de l'événement.`;

const stats = [
  { n: "2ᵉ", l: "salon minéralogique mondial" },
  { n: "1 000+", l: "exposants internationaux" },
  { n: "≈ 52 000 m²", l: "de surface d'exposition" },
  { n: `depuis ${mg.depuis}`, l: "un rendez-vous historique" },
];
---
<Base
  title="Mineral & Gem — Sainte-Marie-aux-Mines"
  description={description}
  active="decouvrir"
  ogImage="/og-mineral-gem.jpg"
>
  <main id="contenu" class="mg is-dark">

    <!-- ============ HERO IMMERSIF ============ -->
    <section class="mg-hero strata" aria-labelledby="mg-title">
      <div class="partition" style="left:64%"></div>
      <div class="wrap mg-hero__grid">
        <div class="mg-hero__text">
          <nav class="mg-crumb" aria-label="Fil d'Ariane">
            <ol>
              <li><a href="/">Accueil</a></li>
              <li aria-hidden="true">›</li>
              <li><a href="/decouvrir/">Découvrir &amp; sortir</a></li>
              <li aria-hidden="true">›</li>
              <li aria-current="page">Mineral &amp; Gem</li>
            </ol>
          </nav>
          <span class="eyebrow eyebrow--gold eyebrow--mark">
            <MinerTools size={22} />
            Le rendez-vous mondial du minéral
          </span>
          <h1 id="mg-title" class="mg-hero__title metal-text mg-sweep">Mineral &amp; Gem</h1>
          <p class="mg-hero__sub">
            {mg.edition} · thème <strong class="mg-theme">«&nbsp;{mg.theme}&nbsp;»</strong>.
            {mg.rang}.
          </p>
          <p class="mg-hero__dates">
            <time datetime={mg.datesIso.debut}>{mg.dates}</time>
            <span class="mg-hero__public">{mg.grandPublic}</span>
          </p>
          <div class="mg-hero__cta">
            <a class="btn btn--ghost-dark" href="#programme">Découvrir le programme</a>
          </div>
        </div>

        <div class="mg-hero__gem" aria-hidden="true">
          <!-- Cristal facetté décoratif : SVG/CSS, zéro licence, zéro JS. -->
          <svg class="gem" viewBox="0 0 220 260" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="gA" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#eef0f2"/><stop offset="1" stop-color="#9fa6ab"/>
              </linearGradient>
              <linearGradient id="gB" x1="1" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#c7ccd1"/><stop offset="1" stop-color="#6b7176"/>
              </linearGradient>
              <linearGradient id="gC" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#e9c98a"/><stop offset="1" stop-color="#9a6f2e"/>
              </linearGradient>
              <linearGradient id="gT" x1="0" y1="0" x2="0.6" y2="1">
                <stop offset="0" stop-color="#f4f6f7"/><stop offset="0.55" stop-color="#aeb4b9"/><stop offset="1" stop-color="#dfe3e5"/>
              </linearGradient>
              <clipPath id="gemClip">
                <polygon points="70,30 150,30 180,60 180,200 150,230 70,230 40,200 40,60"/>
              </clipPath>
            </defs>
            <g class="gem__facets">
              <!-- table -->
              <polygon points="85.2,68 134.8,68 153.4,86.6 153.4,173.4 134.8,192 85.2,192 66.6,173.4 66.6,86.6" fill="url(#gT)"/>
              <!-- couronne (8 facettes en biseau) -->
              <polygon points="70,30 150,30 134.8,68 85.2,68" fill="url(#gA)"/>
              <polygon points="150,30 180,60 153.4,86.6 134.8,68" fill="url(#gC)"/>
              <polygon points="180,60 180,200 153.4,173.4 153.4,86.6" fill="url(#gB)"/>
              <polygon points="180,200 150,230 134.8,192 153.4,173.4" fill="url(#gA)"/>
              <polygon points="150,230 70,230 85.2,192 134.8,192" fill="url(#gB)"/>
              <polygon points="70,230 40,200 66.6,173.4 85.2,192" fill="url(#gC)"/>
              <polygon points="40,200 40,60 66.6,86.6 66.6,173.4" fill="url(#gA)"/>
              <polygon points="40,60 70,30 85.2,68 66.6,86.6" fill="url(#gB)"/>
            </g>
            <g clip-path="url(#gemClip)">
              <rect class="gem__sweep" x="-120" y="-30" width="90" height="320" fill="#ffffff" opacity="0"/>
            </g>
            <polygon points="70,30 150,30 180,60 180,200 150,230 70,230 40,200 40,60"
                     fill="none" stroke="rgba(199,204,209,0.55)" stroke-width="1.5"/>
          </svg>
        </div>
      </div>
    </section>

    <!-- ============ BANDE DE CHIFFRES ============ -->
    <section class="mg-stats" aria-label="Mineral & Gem en chiffres">
      <div class="wrap mg-stats__inner">
        {stats.map((s) => (
          <div class="mg-stat mg-reveal">
            <span class="mg-stat__n">{s.n}</span>
            <span class="mg-stat__l">{s.l}</span>
          </div>
        ))}
      </div>
    </section>

    <hr class="vein" />

    <!-- ============ LES DEUX MONDES (composition « deux versants ») ============ -->
    <section class="mg-worlds strata" aria-labelledby="mg-worlds-title">
      <div class="wrap">
        <div class="mg-section-head mg-reveal">
          <span class="eyebrow eyebrow--gold">La ville aux deux rives</span>
          <h2 id="mg-worlds-title" class="mg-h2">Deux mondes, un seul salon</h2>
          <p class="mg-lede">Comme la ville née de deux rives de la Lièpvrette, le salon se partage en deux univers que sépare une même ligne d'argent.</p>
        </div>
        <div class="mg-split">
          <div class="mg-world mg-reveal">
            <span class="mg-world__kicker">{mg.zones[0].nom}</span>
            <p class="mg-world__desc">{mg.zones[0].desc}</p>
          </div>
          <div class="mg-split__line" aria-hidden="true"></div>
          <div class="mg-world mg-world--gem mg-reveal">
            <span class="mg-world__kicker">{mg.zones[1].nom}</span>
            <p class="mg-world__desc">{mg.zones[1].desc}</p>
          </div>
        </div>
      </div>
    </section>

    <hr class="vein" />

    <!-- ============ EXPOSITION PRESTIGE (sticky storytelling) ============ -->
    <section class="mg-prestige" aria-labelledby="mg-prestige-title">
      <div class="wrap mg-prestige__grid">
        <div class="mg-prestige__sticky">
          <div class="mg-prestige__visual">
            <img class="mg-prestige__img" src={photos.argentTetraedrite.src} alt={photos.argentTetraedrite.alt} width={photos.argentTetraedrite.w} height={photos.argentTetraedrite.h} loading="lazy" />
            <span class="photo-credit">© {photos.argentTetraedrite.auteur} · {photos.argentTetraedrite.licence}</span>
          </div>
        </div>
        <div class="mg-prestige__body">
          <span class="eyebrow eyebrow--gold mg-reveal">Exposition prestige</span>
          <h2 id="mg-prestige-title" class="mg-h2 mg-reveal">«&nbsp;{mg.theme}&nbsp;»</h2>
          <p class="mg-prestige__text mg-reveal">{mg.themeDesc}</p>
          <p class="mg-prestige__text mg-reveal">Chaque année, un thème nouveau réunit des pièces d'exception venues de collections publiques et privées du monde entier — l'occasion de voir réunies des œuvres que l'on ne croise jamais ensemble.</p>
          <p class="mg-prestige__note mg-reveal">Le thème change à chaque édition : il fait l'identité de l'année.</p>
        </div>
      </div>
    </section>

    <hr class="vein" />

    <!-- ============ LE PROGRAMME ============ -->
    <section class="mg-prog" id="programme" aria-labelledby="mg-prog-title">
      <div class="wrap">
        <div class="mg-section-head mg-reveal">
          <span class="eyebrow eyebrow--gold">Pendant le salon</span>
          <h2 id="mg-prog-title" class="mg-h2">Le programme</h2>
        </div>
        <ul class="mg-prog__list" role="list">
          {mg.programme.map((p) => {
            const gabe = p.includes("Gabe Gottes");
            return (
              <li class={`mg-prog__item mg-reveal${gabe ? " mg-prog__item--feature" : ""}`}>
                <span class="mg-prog__mark" aria-hidden="true"><MinerTools size={18} /></span>
                {gabe ? (
                  <span class="mg-prog__txt">
                    {p}
                    <a class="mg-prog__link" href="/decouvrir/#patrimoine">Voir le patrimoine minier de la vallée →</a>
                  </span>
                ) : (
                  <span class="mg-prog__txt">{p}</span>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <hr class="vein" />

    <!-- ============ QUAND & OÙ ============ -->
    <section class="mg-info" aria-labelledby="mg-info-title">
      <div class="wrap mg-info__grid">
        <div class="mg-section-head mg-reveal">
          <span class="eyebrow eyebrow--gold">S'y rendre</span>
          <h2 id="mg-info-title" class="mg-h2">Quand &amp; où</h2>
        </div>
        <dl class="mg-info__dl mg-reveal">
          <div class="mg-info__row">
            <dt>Dates</dt>
            <dd><time datetime={mg.datesIso.debut}>{mg.dates}</time></dd>
          </div>
          <div class="mg-info__row">
            <dt>Grand public</dt>
            <dd>{mg.grandPublic.replace("Ouvert au grand public ", "")}</dd>
          </div>
          <div class="mg-info__row">
            <dt>Horaires</dt>
            <dd>{mg.horaires}</dd>
          </div>
          <div class="mg-info__row">
            <dt>Lieu</dt>
            <dd>{mg.lieu}</dd>
          </div>
          <div class="mg-info__row">
            <dt>Accessibilité</dt>
            <dd>Informations d'accès et de mobilité réduite auprès de l'organisateur (voir le site officiel).</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- ============ CLÔTURE ============ -->
    <section class="mg-outro strata" aria-labelledby="mg-outro-title">
      <div class="partition" style="left:42%"></div>
      <div class="wrap mg-outro__inner">
        <span class="eyebrow eyebrow--gold eyebrow--mark mg-reveal">
          <MinerTools size={20} />
          Un événement, une ville
        </span>
        <h2 id="mg-outro-title" class="mg-outro__title metal-text mg-reveal">Vivez Mineral &amp; Gem</h2>
        <p class="mg-outro__lede mg-reveal">Cinq jours où Sainte-Marie-aux-Mines devient la capitale mondiale du minéral. Le programme détaillé et toutes les informations pratiques sont sur le site officiel de l'événement.</p>
        <a class="mg-outro__link mg-reveal" href={mg.siteOfficielUrl} target="_blank" rel="noopener noreferrer">
          Site officiel de l'événement
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
          <span class="visually-hidden"> (nouvel onglet)</span>
        </a>
        <p class="mg-outro__org mg-reveal">{mg.organisateur}</p>
      </div>
    </section>

  </main>
</Base>

<style>
  /* La page entière est un « moment galerie » : fonds sombres, accents métal. */
  .mg { background: var(--nuit); }
  .mg-h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.1;
    color: var(--clair-2);
    margin: 0.5rem 0 0;
  }
  .mg-lede { font: 400 1rem/1.6 var(--sans); color: var(--brume-2); max-width: 46ch; margin: 0.75rem 0 0; }
  .mg-section-head { margin-bottom: 1.75rem; }

  /* ---- HERO ---- */
  .mg-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(150deg, #241f14, #16140d 70%);
    min-height: clamp(560px, 86vh, 820px);
    display: flex;
    align-items: center;
  }
  .mg-hero__grid {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2.5rem;
    width: 100%;
    padding-block: 3rem;
  }
  .mg-hero__text { flex: 1 1 56%; }
  .mg-crumb { margin-bottom: 1.25rem; }
  .mg-crumb ol {
    list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem;
    margin: 0; padding: 0; font: 500 0.8125rem/1 var(--sans); color: var(--brume-muet);
  }
  .mg-crumb a { color: var(--or); text-decoration: none; }
  .mg-crumb a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .mg-crumb [aria-current="page"] { color: var(--brume); }
  .mg-hero__title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(3rem, 9vw, 6rem);
    line-height: 1;
    margin: 1rem 0 0;
    letter-spacing: -0.01em;
  }
  .mg-hero__sub { font: 400 clamp(1.0625rem, 2.4vw, 1.375rem)/1.5 var(--sans); color: var(--brume); max-width: 40ch; margin: 1.25rem 0 0; }
  .mg-theme { color: var(--or-clair); font-weight: 600; }
  .mg-hero__dates { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1rem; margin: 1.5rem 0 0; }
  .mg-hero__dates time { font-family: var(--serif); font-size: 1.375rem; color: var(--argent); }
  .mg-hero__public { font: 500 0.9375rem/1.4 var(--sans); color: var(--brume-muet); }
  .mg-hero__cta { margin-top: 2rem; }

  /* ---- GEM ---- */
  .mg-hero__gem { flex: 0 0 38%; display: flex; justify-content: center; align-items: center; }
  .gem { width: min(330px, 70%); height: auto; filter: drop-shadow(0 18px 40px rgba(0,0,0,0.5)); transform-origin: center; }
  .gem__facets polygon { stroke: rgba(22,20,13,0.35); stroke-width: 0.6; }

  /* ---- BANDE DE CHIFFRES ---- */
  .mg-stats { background: var(--sable-2); border-top: 1px solid var(--bord-nuit-2); border-bottom: 1px solid var(--bord-nuit-2); }
  .mg-stats__inner { display: flex; flex-wrap: wrap; gap: 1.75rem 2rem; justify-content: space-between; padding-block: 2rem; }
  .mg-stat { display: flex; flex-direction: column; min-width: 8rem; }
  .mg-stat__n { font-family: var(--serif); font-weight: 600; font-size: clamp(1.6rem, 3.4vw, 2.1rem); line-height: 1; color: var(--argent); }
  .mg-stat:nth-child(even) .mg-stat__n { color: var(--or); }
  .mg-stat__l { font: 500 0.84375rem/1.35 var(--sans); color: var(--brume-muet); margin-top: 0.5rem; max-width: 16ch; }

  /* ---- DEUX MONDES ---- */
  .mg-worlds { position: relative; overflow: hidden; background: var(--sable); padding-block: 3.5rem; }
  .mg-split { display: flex; align-items: stretch; gap: 0; margin-top: 0.5rem; }
  .mg-world { flex: 1; padding: 1.5rem 2.5rem; }
  .mg-world:first-of-type { padding-left: 0; }
  .mg-world--gem { padding-right: 0; }
  .mg-split__line { flex: 0 0 2px; background: var(--partage); align-self: stretch; }
  .mg-world__kicker {
    display: inline-block;
    font: 700 0.8125rem/1 var(--sans);
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--or);
    padding-bottom: 0.6rem;
  }
  .mg-world--gem .mg-world__kicker { color: var(--argent-2); }
  .mg-world__desc { font: 400 1rem/1.65 var(--sans); color: var(--brume); margin: 0.5rem 0 0; }

  /* ---- PRESTIGE (sticky storytelling) ---- */
  .mg-prestige { background: var(--nuit); padding-block: 3.5rem; }
  .mg-prestige__grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 3rem; align-items: start; }
  .mg-prestige__sticky { position: sticky; top: calc(var(--header-offset) - 2rem); }
  .mg-prestige__visual {
    position: relative; aspect-ratio: 4 / 5; border-radius: var(--rayon-lg); overflow: hidden;
    border: 1px solid var(--bord-nuit); background: linear-gradient(155deg, #2b2920, #100f0a);
  }
  .mg-prestige__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .mg-prestige__body { padding-top: 0.5rem; }
  .mg-prestige__text { font: 400 1.0625rem/1.7 var(--sans); color: var(--brume); margin: 1rem 0 0; max-width: 48ch; }
  .mg-prestige__note { font: 500 0.9375rem/1.5 var(--sans); color: var(--brume-muet); font-style: italic; margin: 1.25rem 0 0; }

  /* ---- PROGRAMME ---- */
  .mg-prog { background: var(--sable); padding-block: 3.5rem; }
  .mg-prog__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; max-width: 60rem; }
  .mg-prog__item {
    display: flex; align-items: flex-start; gap: 1rem;
    background: var(--carte-nuit); border: 1px solid var(--bord-nuit); border-radius: var(--rayon);
    padding: 1.1rem 1.25rem;
  }
  .mg-prog__mark { flex: none; color: var(--or); margin-top: 0.1rem; }
  .mg-prog__txt { font: 500 1.0625rem/1.45 var(--sans); color: var(--clair-3); }
  .mg-prog__item--feature { border-color: rgba(176,134,60,0.5); background: linear-gradient(120deg, #221d12, #1a1813); }
  .mg-prog__link { display: inline-block; margin-top: 0.5rem; color: var(--or); font-weight: 600; font-size: 0.9375rem; text-decoration: none; }
  .mg-prog__link:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* ---- QUAND & OÙ ---- */
  .mg-info { background: var(--nuit); padding-block: 3.5rem; }
  .mg-info__dl { margin: 0; max-width: 44rem; border-top: 1px solid var(--bord-nuit); }
  .mg-info__row { display: grid; grid-template-columns: 12rem 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--bord-nuit); }
  .mg-info__row dt { font: 700 0.8125rem/1.4 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--or); }
  .mg-info__row dd { margin: 0; font: 400 1.0625rem/1.5 var(--sans); color: var(--brume); }
  .mg-info__row dd time { color: var(--argent); }

  /* ---- CLÔTURE ---- */
  .mg-outro { position: relative; overflow: hidden; background: linear-gradient(150deg, #221d12, #100f0a); padding-block: 4rem; }
  .mg-outro__inner { position: relative; max-width: 46rem; text-align: center; margin-inline: auto; }
  .mg-outro__title { font-family: var(--serif); font-weight: 600; font-size: clamp(2.25rem, 6vw, 3.5rem); line-height: 1.05; margin: 1rem 0 0; }
  .mg-outro__lede { font: 400 1.0625rem/1.7 var(--sans); color: var(--brume); margin: 1.25rem auto 0; max-width: 42ch; }
  .mg-outro__link {
    display: inline-flex; align-items: center; gap: 0.6rem; margin-top: 2rem;
    background: transparent; color: var(--clair-2);
    border: 1px solid rgba(199,204,209,0.45); border-radius: var(--rayon);
    padding: 0.85rem 1.5rem; min-height: 44px;
    font: 600 1rem/1 var(--sans); text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .mg-outro__link:hover { background: rgba(199,204,209,0.1); border-color: var(--or); }
  .mg-outro__link svg { flex: none; }
  .mg-outro__org { font: 400 0.84375rem/1.6 var(--sans); color: var(--brume-muet); margin: 1.5rem auto 0; max-width: 46ch; }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 900px) {
    .mg-hero .partition, .mg-outro .partition { display: none; }
    .mg-hero__grid { flex-direction: column-reverse; align-items: flex-start; gap: 1.5rem; }
    .mg-hero__gem { align-self: center; }
    .gem { width: min(220px, 56vw); }
    .mg-prestige__grid { grid-template-columns: 1fr; gap: 1.75rem; }
    .mg-prestige__sticky { position: static; }
    .mg-prestige__visual { aspect-ratio: 16 / 10; }
  }
  @media (max-width: 680px) {
    .mg-split { flex-direction: column; }
    .mg-split__line { display: none; }
    .mg-world { padding: 1.25rem 0; border-top: 1px solid var(--bord-nuit); }
    .mg-world:first-of-type { border-top: 0; }
    .mg-info__row { grid-template-columns: 1fr; gap: 0.25rem; }
  }

  /* ====================================================================
     ANIMATIONS — défilement (scroll-driven CSS), sans JS.
     Par défaut : contenu visible, aucune animation (amélioration progressive).
     ==================================================================== */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .mg-reveal {
        opacity: 0;
        animation: mg-reveal-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 55%;
      }
      @keyframes mg-reveal-in {
        from { opacity: 0; transform: translateY(1.75rem); }
        to   { opacity: 1; transform: none; }
      }
      /* Balayage de lumière sur le titre métal, lié au défilement de la page. */
      .mg-sweep {
        background-size: 220% 100%;
        animation: mg-shine linear both;
        animation-timeline: scroll(root);
      }
      @keyframes mg-shine {
        from { background-position: 0% 50%; }
        to   { background-position: 100% 50%; }
      }
    }

    /* Cristal : flottement + balayage lumineux (transform/opacity uniquement). */
    .gem { animation: gem-float 6s ease-in-out infinite; }
    @keyframes gem-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-0.625rem); } }
    .gem__sweep { animation: gem-sweep 4.8s ease-in-out infinite; }
    @keyframes gem-sweep {
      0%   { transform: translateX(0);     opacity: 0; }
      35%  { opacity: 0.5; }
      70%  { transform: translateX(300px); opacity: 0; }
      100% { transform: translateX(300px); opacity: 0; }
    }
  }
</style>
