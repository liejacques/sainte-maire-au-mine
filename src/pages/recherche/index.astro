---
// Recherche plein-texte du site, propulsée par Pagefind (index statique généré
// au build : `pagefind --site dist`). Les fichiers /pagefind/* n'existent que
// dans le site construit (npm run build / preview), pas en `astro dev`.
import InnerPage from "../../layouts/InnerPage.astro";

const fil = [{ label: "Accueil", href: "/" }, { label: "Recherche" }];
---
<InnerPage
  title="Rechercher"
  description="Rechercher une démarche, un service ou une page sur le site de Sainte-Marie-aux-Mines."
  eyebrow="Recherche"
  breadcrumb={fil}
  lede="Trouvez une démarche, un service, une actualité ou une page du site."
>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <div id="search" class="pf"></div>
  <p id="pf-fallback" class="pf-fallback">
    Le moteur de recherche s'active sur le site publié. En développement local,
    lancez <code>npm run build &amp;&amp; npm run preview</code> pour l'essayer.
  </p>

  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      if (typeof window.PagefindUI !== "function") return;
      const fb = document.getElementById("pf-fallback");
      if (fb) fb.hidden = true;
      new window.PagefindUI({
        element: "#search",
        showSubResults: true,
        showImages: false,
        translations: {
          placeholder: "Rechercher une démarche, un service…",
          clear_search: "Effacer",
          load_more: "Voir plus de résultats",
          search_label: "Rechercher sur le site",
          zero_results: "Aucun résultat pour « [SEARCH_TERM] »",
          many_results: "[COUNT] résultats pour « [SEARCH_TERM] »",
          one_result: "[COUNT] résultat pour « [SEARCH_TERM] »",
        },
      });
      const q = new URLSearchParams(location.search).get("q");
      if (q) {
        const input = document.querySelector(".pagefind-ui__search-input");
        if (input) {
          input.value = q;
          input.dispatchEvent(new Event("input", { bubbles: true }));
        }
      }
    });
  </script>

  <style is:global>
    /* Thème Pagefind UI accordé à la charte (gueules + parchemin). */
    :root {
      --pagefind-ui-primary: var(--gueules);
      --pagefind-ui-text: var(--encre);
      --pagefind-ui-background: var(--parchemin-2);
      --pagefind-ui-border: var(--bord-clair);
      --pagefind-ui-tag: var(--parchemin);
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: 4px;
      --pagefind-ui-font: var(--sans);
    }
  </style>
  <style>
    .pf { max-width: 720px; }
    .pf-fallback { margin-top: 18px; color: var(--texte-muet); font-size: 0.90625rem; max-width: 720px; }
    .pf-fallback code { background: var(--parchemin); border: 1px solid var(--bord-clair); border-radius: 3px; padding: 2px 6px; }
    .pf-fallback[hidden] { display: none; }
  </style>
</InnerPage>
