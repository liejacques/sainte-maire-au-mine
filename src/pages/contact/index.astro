---
import InnerPage from "../../layouts/InnerPage.astro";
import AccessMap from "../../components/AccessMap.astro";
import { mairie } from "../../data/commune";

const description =
  "Contacter la mairie de Sainte-Marie-aux-Mines : formulaire de contact, coordonnées, horaires d'ouverture au public et plan d'accès.";

const fil = [
  { label: "Accueil", href: "/" },
  { label: "Ma mairie", href: "/ma-mairie/" },
  { label: "Contact & horaires" },
];

const services = [
  "Accueil général",
  "État civil",
  "Urbanisme",
  "Scolaire & périscolaire",
  "Technique & voirie",
];
---
<InnerPage
  title="Contacter la mairie"
  description={description}
  active="mairie"
  eyebrow="Ma mairie"
  bannerTitle="Contacter la mairie"
  breadcrumb={fil}
>
  <div class="contact-grid">
    <!-- ============ FORMULAIRE ============ -->
    <div class="contact-form-col">
      <h2 class="contact-form-col__title">Nous écrire</h2>
      <p class="contact-form-col__intro">
        Une question, une demande&nbsp;? Remplissez le formulaire ci-dessous. Les
        champs marqués d'un astérisque (*) sont obligatoires.
      </p>

      <p class="form-status" id="contact-status" role="status" hidden></p>

      <form
        id="contact-form"
        class="contact-form card"
        data-sujet="Message de contact — Sainte-Marie-aux-Mines"
        data-mairie-email={mairie.email}
      >
        <!-- Honeypot anti-spam (caché aux humains et aux lecteurs d'écran). -->
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" hidden />
        <div class="contact-form__row">
          <div class="field">
            <label for="ct-nom">Nom *</label>
            <input id="ct-nom" name="nom" class="input" type="text" autocomplete="family-name" required />
          </div>
          <div class="field">
            <label for="ct-prenom">Prénom *</label>
            <input id="ct-prenom" name="prenom" class="input" type="text" autocomplete="given-name" required />
          </div>
        </div>

        <div class="contact-form__row">
          <div class="field">
            <label for="ct-email">E-mail *</label>
            <input id="ct-email" name="email" class="input" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="ct-sujet">Service concerné</label>
            <select id="ct-sujet" name="service" class="select">
              {services.map((s) => <option>{s}</option>)}
            </select>
          </div>
        </div>

        <div class="field contact-form__field">
          <label for="ct-msg">Votre message *</label>
          <textarea id="ct-msg" name="message" class="textarea" rows="5" required></textarea>
        </div>

        <label class="consent contact-form__consent">
          <input type="checkbox" name="consentement" required />
          <span>
            J'accepte que mes données soient traitées par la mairie pour répondre
            à ma demande, conformément à la
            <a href="/confidentialite/">politique de confidentialité</a>. *
          </span>
        </label>

        <button type="submit" class="btn btn--primary">Envoyer le message</button>
      </form>
    </div>

    <!-- ============ ASIDE ============ -->
    <aside class="contact-aside">
      <div class="action-card">
        <h2>Coordonnées</h2>
        <address class="contact-coords">
          <strong>{mairie.nom}</strong><br />
          {mairie.adresse}<br />
          {mairie.cp} {mairie.ville}
          <a class="contact-coords__link" href={`tel:${mairie.telE164}`}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 16.5v3a2 2 0 0 1-2.2 2 19 19 0 0 1-8.3-3 19 19 0 0 1-6-6 19 19 0 0 1-3-8.3A2 2 0 0 1 3.5 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L7.5 9.6a16 16 0 0 0 6 6l1.2-1.1a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2z"/></svg>
            {mairie.tel}
          </a>
          <a class="contact-coords__link" href={`mailto:${mairie.email}`}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 5l9 7 9-7"/><rect x="3" y="5" width="18" height="14" rx="2"/></svg>
            {mairie.email}
          </a>
        </address>
      </div>

      <div class="info-card">
        <h2>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          Horaires d'ouverture
        </h2>
        <dl>
          {mairie.horaires.map((h) => (
            <div>
              <dt>{h.jour}</dt>
              <dd style={h.ferme ? "color:var(--texte-faible);font-weight:400" : ""}>{h.h}</dd>
            </div>
          ))}
        </dl>
      </div>

      <AccessMap height={240} class="contact-map" />
    </aside>
  </div>
</InnerPage>

<script>
  import { initPublicForm } from "../../lib/forms-client";
  const status = document.getElementById("contact-status");
  initPublicForm("contact-form", (etat) => {
    if (!status) return;
    status.hidden = false;
    status.dataset.etat = etat;
    status.textContent =
      etat === "chargement"
        ? "Envoi du message en cours…"
        : etat === "ok"
          ? "Votre message a bien été envoyé. La mairie vous répondra sous 48 heures ouvrées."
          : etat === "mailto"
            ? "Votre messagerie va s'ouvrir pour finaliser l'envoi de votre message."
            : "Une erreur est survenue. Réessayez plus tard.";
    try { status.scrollIntoView({ behavior: "smooth", block: "center" }); } catch (_) {}
  });
</script>

<style>
  /* ---- Grille 2 colonnes (formulaire + aside) ---- */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 44px;
    align-items: start;
  }

  /* ---- Colonne formulaire ---- */
  .contact-form-col__title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.625rem;
    color: var(--encre);
    margin: 0 0 6px;
  }
  .contact-form-col__intro {
    font: 400 0.96875rem/1.6 var(--sans);
    color: var(--texte-2);
    margin: 0 0 24px;
    max-width: 560px;
  }

  .contact-form { padding: 28px; }
  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }
  .contact-form__field { margin-bottom: 16px; }
  .contact-form__consent { margin: 0 0 20px; }
  .contact-form .form-status[hidden] { display: none; }

  /* ---- Aside ---- */
  .contact-aside {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .contact-coords {
    font-style: normal;
    font: 400 0.90625rem/1.7 var(--sans);
    color: var(--brume);
  }
  .contact-coords strong { color: var(--clair); }
  .contact-coords__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--argent);
    font-weight: 600;
    text-decoration: none;
    margin-top: 8px;
  }
  .contact-coords__link:hover { color: var(--clair-3); text-decoration: underline; text-underline-offset: 3px; }
  .contact-coords__link svg { flex: none; }

  /* ---- Responsive ---- */
  @media (max-width: 880px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .contact-form { padding: 22px 18px; }
    .contact-form__row { grid-template-columns: 1fr; }
  }
</style>
