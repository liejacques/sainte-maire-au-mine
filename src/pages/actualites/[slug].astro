---
import InnerPage from "../../layouts/InnerPage.astro";
import { articles } from "../../data/actualites";

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const description = article.resume;
const fil = [
  { label: "Accueil", href: "/" },
  { label: "Actualités", href: "/actualites/" },
  { label: article.titre },
];
---
<InnerPage
  title={article.titre}
  description={description}
  active="decouvrir"
  eyebrow={article.categorie}
  bannerTitle={article.titre}
  breadcrumb={fil}
>
  <article class="actu-article">
    <time datetime={article.iso} class="meta-date">{article.date}</time>

    <figure class="actu-article__photo photo-block photo-block--photo">
      <img class="photo-block__img" src={article.image.src} alt={article.image.alt} width={article.image.w} height={article.image.h} />
      <span class="photo-credit">© {article.image.auteur} · {article.image.licence}</span>
      <figcaption class="photo-block__title">{article.image.titre}</figcaption>
    </figure>

    <div class="prose">
      {article.contenu.map((p) => <p>{p}</p>)}
    </div>

    <p class="actu-article__retour">
      <a class="link-more link-more--gold" href="/actualites/">← Toutes les actualités</a>
    </p>
  </article>
</InnerPage>

<style>
  .actu-article { max-width: 760px; }
  .actu-article .meta-date { display: block; margin-bottom: 16px; }
  .actu-article__photo {
    min-height: 300px;
    margin-bottom: 32px;
  }
  .actu-article__retour { margin-top: 32px; }
</style>
