---
import { footerNav, legalNav } from "../data/nav";
import { mairie, commune, partenaires, reseaux } from "../data/commune";
import Blason from "./Blason.astro";

// Source unique des réseaux : src/data/commune.ts (jamais de href="#").
const socialIcons: Record<string, string> = {
  facebook: '<path d="M14 9h3V6h-3a4 4 0 0 0-4 4v2H8v3h2v6h3v-6h3l1-3h-4v-2a1 1 0 0 1 1-1z"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1"/>',
  youtube: '<path d="M22 8a3 3 0 0 0-2-2c-1.8-.5-8-.5-8-.5s-6.2 0-8 .5a3 3 0 0 0-2 2 31 31 0 0 0 0 8 3 3 0 0 0 2 2c1.8.5 8 .5 8 .5s6.2 0 8-.5a3 3 0 0 0 2-2 31 31 0 0 0 0-8zM10 15V9l5 3z"/>',
};
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">
          <Blason width={40} height={46} />
          <span class="footer-brand__name">Ville de<br />{commune.nom}</span>
        </div>
        <address class="footer-address">
          {mairie.adresse}<br />
          {mairie.cp} {mairie.ville}<br />
          <a href={`tel:${mairie.telE164}`}>{mairie.tel}</a>
        </address>
        {reseaux.length > 0 && (
          <div class="footer-social">
            {reseaux.map((r) => (
              <a href={r.href} target="_blank" rel="noopener noreferrer" aria-label={`${r.nom} de la ville (nouvel onglet)`}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={socialIcons[r.icone]} />
              </a>
            ))}
          </div>
        )}
      </div>

      {footerNav.map((col) => (
        <nav class="footer-col" aria-label={`Pied de page — ${col.titre}`}>
          <h2>{col.titre}</h2>
          <ul>
            {col.liens.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}

      <div class="footer-col">
        <h2>Partenaires</h2>
        <div class="footer-partners">
          {partenaires.map((p) => (
            <div class="footer-partner">{p}</div>
          ))}
        </div>
      </div>
    </div>

    <div class="footer-legal">
      <nav aria-label="Liens légaux">
        <a href="/accessibilite/">
          <span class="rgaa-badge">RGAA</span>Accessibilité : partiellement conforme
        </a>
        {legalNav.map((l) => (
          <a href={l.href}>{l.label}</a>
        ))}
      </nav>
      <p class="footer-legal__copy">© 2026 Ville de {commune.nom}</p>
    </div>
  </div>
</footer>
