---
// Motif signature : marteau et pointerolle du mineur d'argent croisés en
// sautoir (repris du blason). Sert d'ornement de surtitre et de puce de section.
// Décoratif : toujours aria-hidden ; la couleur suit currentColor.
interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: cls } = Astro.props;
---
<svg viewBox="0 0 64 64" width={size} height={size} class={cls} aria-hidden="true" fill="currentColor">
  <g transform="rotate(45 32 32)">
    <rect x="29.5" y="9" width="5" height="33" rx="1.2"/>
    <polygon points="29.5,41 34.5,41 32,52"/>
    <rect x="27.5" y="8" width="9" height="5" rx="1.5"/>
  </g>
  <g transform="rotate(-45 32 32)">
    <rect x="30" y="16" width="4.5" height="38" rx="1.2"/>
    <rect x="21" y="9" width="22" height="10" rx="2.5"/>
  </g>
</svg>
