---
import { mainNav } from "../data/nav";
import { commune } from "../data/commune";
import Blason from "./Blason.astro";

interface Props {
  /** id de rubrique active (ex. "demarches") pour surligner l'onglet. */
  active?: string;
}
const { active } = Astro.props;
---

<!-- ============ BARRE UTILITAIRE ============ -->
<div class="utility-bar">
  <div class="utility-bar__inner">
    <div class="utility-bar__extra">
      <a class="utility-bar__link" href="/contact/">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        Lun–Ven · 8h30–12h / 14h–17h
      </a>
      <a class="utility-bar__link" href="/contact/">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 5l9 7 9-7"/><rect x="3" y="5" width="18" height="14" rx="2"/></svg>
        Contact
      </a>
    </div>
    <div class="utility-bar__a11y">
      <span class="a11y-label">Accessibilité&nbsp;:</span>
      <div class="a11y-group" role="group" aria-label="Taille du texte">
        <button type="button" class="a11y-btn a11y-btn--sm" data-text-size="1" aria-pressed="true" aria-label="Texte taille normale">A</button>
        <button type="button" class="a11y-btn a11y-btn--md" data-text-size="1.15" aria-pressed="false" aria-label="Texte agrandi">A</button>
        <button type="button" class="a11y-btn a11y-btn--lg" data-text-size="1.3" aria-pressed="false" aria-label="Texte très agrandi">A</button>
      </div>
      <button type="button" class="a11y-btn a11y-btn--text" data-contrast-toggle aria-pressed="false">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" stroke="none"/></svg>
        Contraste
      </button>
    </div>
  </div>
</div>

<!-- ============ EN-TÊTE + NAVIGATION ============ -->
<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label={`Accueil — Ville de ${commune.nom}`}>
      <Blason width={52} height={60} />
      <span>
        <span class="brand__name">{commune.nom}</span>
        <span class="brand__baseline">{commune.baseline}</span>
      </span>
    </a>

    <!-- Navigation bureau : menus déroulants en CSS pur (hover + focus-within). -->
    <nav class="main-nav" aria-label="Navigation principale">
      {mainNav.map((item) => (
        <div class="nav-item">
          <a
            class="nav-item__link"
            href={item.href}
            aria-current={active === item.id ? "page" : undefined}
          >
            {item.label}
            <svg class="nav-item__caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 9l7 7 7-7"/></svg>
          </a>
          <div class="nav-panel">
            {item.children.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        </div>
      ))}
    </nav>

    <!-- Tiroir mobile : <details> natif (aucun JS requis pour l'ouverture). -->
    <details class="mobile-menu">
      <summary class="burger" aria-label="Ouvrir le menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </summary>
      <nav class="mobile-panel" aria-label="Navigation principale (mobile)">
        {mainNav.map((item) => (
          <details open={active === item.id}>
            <summary>
              {item.label}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#b0863c" stroke-width="2.5" aria-hidden="true"><path d="M5 9l7 7 7-7"/></svg>
            </summary>
            <div class="mobile-panel__sub">
              <a href={item.href}>Tout&nbsp;: {item.label}</a>
              {item.children.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          </details>
        ))}
      </nav>
    </details>
  </div>
</header>
