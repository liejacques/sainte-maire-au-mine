---
// Seul script client du site (amélioration progressive, non bloquant) :
//   1. sélecteur d’accessibilité — taille du texte (×1 / ×1.15 / ×1.3) et
//      contraste renforcé, mémorisés d’une page à l’autre (localStorage) ;
//   2. confort du tiroir mobile — fermeture à la touche Échap, verrou de
//      défilement de l’arrière-plan, fermeture au clic sur un lien.
// Sans JavaScript, la page reste entièrement lisible et navigable.
---
<script>
  // ---- 1) Sélecteur d’accessibilité --------------------------------
  const SIZE_KEY = "smam-text-size";
  const CONTRAST_KEY = "smam-contrast";

  const sizeButtons = Array.from(document.querySelectorAll("[data-text-size]"));
  const contrastButtons = Array.from(document.querySelectorAll("[data-contrast-toggle]"));

  // Mise à l’échelle standard (rem) : on pose une variable CSS sur :root, que la
  // font-size de <html> applique via calc(). Tout le texte (exprimé en rem) suit.
  // Remplace `style.zoom`, non standard et longtemps absent de Firefox.
  const applySize = (size: string) => {
    document.documentElement.style.setProperty("--smam-text-scale", String(size));
    sizeButtons.forEach((b) => {
      const pressed = b.getAttribute("data-text-size") === String(size);
      b.setAttribute("aria-pressed", pressed ? "true" : "false");
    });
  };

  const applyContrast = (on: boolean) => {
    document.body.setAttribute("data-contrast", on ? "on" : "off");
    contrastButtons.forEach((b) => b.setAttribute("aria-pressed", on ? "true" : "false"));
  };

  // État initial (mémorisé)
  let savedSize = "1";
  let savedContrast = false;
  try {
    savedSize = localStorage.getItem(SIZE_KEY) || "1";
    savedContrast = localStorage.getItem(CONTRAST_KEY) === "on";
  } catch (e) { /* stockage indisponible : valeurs par défaut */ }
  if (savedSize !== "1") applySize(savedSize);
  else applySize("1");
  if (savedContrast) applyContrast(true);

  sizeButtons.forEach((b) => {
    b.addEventListener("click", () => {
      const size = b.getAttribute("data-text-size") || "1";
      applySize(size);
      try { localStorage.setItem(SIZE_KEY, size); } catch (e) { /* */ }
    });
  });

  contrastButtons.forEach((b) => {
    b.addEventListener("click", () => {
      const on = document.body.getAttribute("data-contrast") !== "on";
      applyContrast(on);
      try { localStorage.setItem(CONTRAST_KEY, on ? "on" : "off"); } catch (e) { /* */ }
    });
  });

  // ---- 2) Confort du tiroir mobile ---------------------------------
  const mobileMenus = Array.from(document.querySelectorAll<HTMLDetailsElement>("details.mobile-menu"));
  const closeMobile = () => mobileMenus.forEach((m) => m.removeAttribute("open"));

  mobileMenus.forEach((menu) => {
    // Verrou de défilement quand le tiroir est ouvert.
    menu.addEventListener("toggle", () => {
      document.body.style.overflow = menu.open ? "hidden" : "";
    });
    // Fermeture au clic sur un lien du tiroir.
    menu.querySelectorAll(".mobile-panel a").forEach((link) => {
      link.addEventListener("click", () => menu.removeAttribute("open"));
    });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMobile();
  });

  // ---- 3) Socle d'animations : révélation au défilement -------------
  // Un seul IntersectionObserver réutilisable (onVisible) : déclenche un
  // callback une fois quand l'élément entre dans le viewport, puis cesse de
  // l'observer (pas de re-déclenchement). Sans IntersectionObserver, le
  // callback s'exécute immédiatement (contenu visible, pas de régression).
  const onceCallbacks = new WeakMap<Element, (el: Element) => void>();
  const onceObserver =
    "IntersectionObserver" in window
      ? new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const cb = onceCallbacks.get(entry.target);
              if (cb) cb(entry.target);
              obs.unobserve(entry.target);
              onceCallbacks.delete(entry.target);
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
        )
      : null;

  const onVisible = (el: Element, cb: (el: Element) => void) => {
    if (!onceObserver) { cb(el); return; }
    onceCallbacks.set(el, cb);
    onceObserver.observe(el);
  };

  // Révélations : ajoute .is-visible (l'animation est portée par le CSS, qui
  // ne masque rien sans JS ni en reduced-motion).
  document
    .querySelectorAll(".reveal")
    .forEach((el) => onVisible(el, (t: Element) => t.classList.add("is-visible")));

  // ---- 4) Compteurs animés (statistiques) ---------------------------
  // La valeur finale est le contenu HTML (progressive enhancement) : sans JS,
  // le bon nombre s'affiche. Le JS anime seulement de 0 vers cette valeur.
  // En reduced-motion : valeur finale directe. Séparateur de milliers = espace
  // insécable (format français).
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const frThousands = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, " ");
  const animateCount = (el: Element) => {
    const raw = (el.textContent || "").trim();
    const m = raw.match(/\d[\d   ]*\d|\d/); // suite de chiffres (espaces tolérés)
    if (!m) return;
    const target = parseInt(m[0].replace(/\D/g, ""), 10);
    if (!Number.isFinite(target)) return;
    const idx = m.index ?? 0;
    const prefix = raw.slice(0, idx);
    const suffix = raw.slice(idx + m[0].length);
    if (reduceMotion) { el.textContent = prefix + frThousands(target) + suffix; return; }
    const duration = 1200;
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
    let startTime = 0;
    const tick = (now: number) => {
      if (!startTime) startTime = now;
      const p = Math.min((now - startTime) / duration, 1);
      el.textContent = prefix + frThousands(Math.round(easeOut(p) * target)) + suffix;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  document.querySelectorAll(".count").forEach((el) => onVisible(el, animateCount));

  // ---- 5) Blur-up : fondu des images au chargement ------------------
  document.querySelectorAll("img.blur-up").forEach((img) => {
    if (img instanceof HTMLImageElement && img.complete) img.classList.add("is-loaded");
    else img.addEventListener("load", () => img.classList.add("is-loaded"), { once: true });
  });
</script>
